# CognoDB — create a free c0 instance at https://console.cognodb.com/signup
# The connection URI looks like bolt+s://<instance-id>.<region>.databases.cognodb.com
# NOTE: the assignment PDF documents ".databases.cognodb.cloud"; the console issues ".cognodb.com".
COGNODB_URI=bolt+s://your-instance.region.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Anthropic — powers the natural-language chat over the graph.
# Optional: with no key the chat disables itself and the graph explorer is unaffected.
ANTHROPIC_API_KEY=

# Chat guardrails for a public demo (both optional; defaults shown)
CHAT_DAILY_TOKEN_BUDGET=300000
CHAT_RATE_LIMIT=8

# API
PORT=3101
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3101
