# CognoDB — create a free c0 instance at https://console.cognodb.com/signup
# The connection URI looks like bolt+s://<instance-id>.<region>.databases.cognodb.com
# NOTE: the assignment PDF documents ".databases.cognodb.cloud"; the console issues ".cognodb.com".
COGNODB_URI=bolt+s://your-instance.region.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Anthropic — powers the natural-language chat over the graph.
# Optional: with no key the chat disables itself and the graph explorer is unaffected.
ANTHROPIC_API_KEY=

# Claude Haiku 4.5 by default: the cheapest current model at $1/$5 per million tokens,
# against Opus 5 at $5/$25. Picking one of eight tools and writing three sentences does not
# need a frontier model. Note that adaptive thinking and output_config.effort are 4.6-and-later
# features -- the API omits them automatically for models that reject them.
ANTHROPIC_MODEL=claude-haiku-4-5

# Chat guardrails for a public demo (both optional; defaults shown)
CHAT_DAILY_TOKEN_BUDGET=300000
CHAT_RATE_LIMIT=8

# API
PORT=3101
# Only needed if a browser talks to the API directly. In the deployed setup it does not:
# the web app proxies every call server-side, so CORS never comes into play.
CORS_ORIGIN=http://localhost:3000

# Shared secret between the web app's server and the API. Leave unset locally; set the same value
# on both in production. The browser never sees it.
API_SHARED_SECRET=

# --- Web ---
# Where the web app's server reaches the API. Server-only, deliberately not NEXT_PUBLIC_.
API_URL=http://localhost:3101

# The demo password. Unset means no login at all, which is what you want locally.
APP_PASSWORD=

# Seed scale. Defaults produce 3,607 nodes / 15,350 relationships and a hero query of ~1.4s.
# Tripling these was measured: the loader copes fine (70s), but ownership traversals go to 3.5-4.2s
# because cost scales with path count. The extra companies are random filler -- they do not enrich
# the planted scenario, they only slow the two headline queries. Raise with that trade in mind.
SEED_COMPANIES=2000
SEED_PEOPLE=1200
